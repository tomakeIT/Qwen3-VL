    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backfill LeRobot Progress",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/inference/backfill.py",
            "console": "integratedTerminal",
            "env": {
                "WANDB_PROJECT": "qwen3vl-rewardmodel"
            },
            "args": [
            // Arguments corresponding to run_backfil_lerobot_progress.sh
            "--adapter", "/home/jialeng/LightwheelData/checkpoint-success-6tasks",
            "--dataset-root", "/home/jialeng/LightwheelDataFast/Robocasa_lerobot_6tasks",
            "--output-root", "/home/jialeng/LightwheelDataFast/Robocasa_lerobot_6tasks_with_progress2",
            "--reference-map", "/home/jialeng/Qwen3-VL/inference/data/6tasks_referece_map.json",
            "--config", "dataset/configs/build_config_15tasks.yaml",
            "--num-gpus", "6",
            "--batch-size", "32",
            "--episode-chunk-size", "4",
            "--wandb-run-name", "lerobot_backfill_6tasks"
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}